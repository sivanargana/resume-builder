generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum WorkStatus {
  Fresher
  Experienced
}

enum EmploymentType {
  fulltime
  internship
  contract
  parttime
  freelance
}

enum EducationType {
  fulltime
  parttime
  distance
}

enum SalaryBreakdown {
  fixed
  ctc
}

enum Proficiency {
  beginner
  proficient
  expert
}

model User {
  id         String     @id @default(cuid())
  fullName   String
  mobile     String     @unique
  email      String     @unique
  password   String     @default("")
  workStatus WorkStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  basicDetails   BasicDetails?
  headline       Headline?
  profileSummary ProfileSummary?

  skills      Skill[]
  experiences Experience[]
  educations  Education[]
  projects    Project[]
  languages   Language[]
}

model BasicDetails {
  id String @id @default(cuid())

  photo String?

  experienceYears  Int
  experienceMonths Int

  salaryAmount    Int
  salaryBreakdown SalaryBreakdown

  country  String
  location String

  availability String

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Headline {
  id    String @id @default(cuid())
  value String

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProfileSummary {
  id      String @id @default(cuid())
  summary String

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Skill {
  id   String @id @default(cuid())
  name String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model Experience {
  id String @id @default(cuid())

  isCurrentEmployment Boolean

  employmentType EmploymentType

  companyName String?
  jobTitle    String?
  department  String?
  location    String?

  joiningDate DateTime?
  workedTill  DateTime?

  monthlyStipend Int?
  currentSalary  Int?

  totalExperience Int?

  jobProfile   String?
  noticePeriod String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  skills ExperienceSkill[]
}

model ExperienceSkill {
  id String @id @default(cuid())

  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  name String
}

model Education {
  id String @id @default(cuid())

  education      String
  university     String
  course         String
  specialization String?

  type EducationType

  startYear Int?
  endYear   Int?

  gradeSystem String?
  marks       String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id String @id @default(cuid())

  title  String
  client String?
  status String?

  startYear Int?
  endYear   Int?

  details String?

  location String?
  site     String?
  type     String?

  teamSize Int?

  role            String?
  roleDescription String?

  skillsUsed String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Language {
  id String @id @default(cuid())

  name String

  proficiency Proficiency

  read  Boolean
  write Boolean
  speak Boolean

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}
