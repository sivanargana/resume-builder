generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// start

enum ProjectStatus {
  COMPLETED
  INPROGRESS
  ONHOLD
}

enum GradeSystem {
  CGPA
  GPA
  Percentage
}

model WorkStatus {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // @Relations
  users     User[]
}

model ExperienceYear {
  id           String         @id @default(uuid())
  name         String         @unique
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  // @Relations
  basicDetails BasicDetails[]
}

model ExperienceMonth {
  id           String         @id @default(uuid())
  name         String         @unique
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  // @Relations
  basicDetails BasicDetails[]
}

model SalaryBreakdown {
  id           String         @id @default(uuid())
  name         String         @unique
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  // @Relations
  basicDetails BasicDetails[]
}

model AvailabilityType {
  id           String         @id @default(uuid())
  name         String         @unique
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  // @Relations
  basicDetails BasicDetails[]
}

model EmploymentType {
  id          String       @id @default(uuid())
  name        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  // @Relations
  experiences Experience[]
}

model EducationType {
  id        String      @id @default(uuid())
  name      String      @unique
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  // @Relations
  education Education[]
}

model Proficiency {
  id            String         @id @default(uuid())
  name          String         @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  // @Relations
  userLanguages UserLanguage[]
}

model Skill {
  id         String      @id @default(uuid())
  name       String      @unique
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  // @Relations
  userSkills UserSkill[]
}

model Language {
  id            String         @id @default(uuid())
  name          String         @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  // @Relations
  userLanguages UserLanguage[]
}

model User {
  id             String          @id @default(uuid())
  workStatusId   String?
  fullName       String
  mobile         String          @unique
  email          String          @unique
  password       String          @default("")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  // @Relations
  workStatus     WorkStatus?     @relation(fields: [workStatusId], references: [id])
  basicDetails   BasicDetails?
  headline       Headline?
  profileSummary ProfileSummary?
  userSkills     UserSkill[]
  userLanguages  UserLanguage[]
  experiences    Experience[]
  education      Education[]
  projects       Project[]

  @@index([workStatusId])
}

model BasicDetails {
  id                 String           @id @default(uuid())
  userId             String           @unique
  experienceYearId   String
  experienceMonthId  String
  salaryBreakdownId  String
  availabilityTypeId String
  photo              String?
  salaryAmount       Int
  country            String
  location           String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  // @Relations
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  experienceYear     ExperienceYear   @relation(fields: [experienceYearId], references: [id])
  experienceMonth    ExperienceMonth  @relation(fields: [experienceMonthId], references: [id])
  salaryBreakdown    SalaryBreakdown  @relation(fields: [salaryBreakdownId], references: [id])
  availabilityType   AvailabilityType @relation(fields: [availabilityTypeId], references: [id])

  @@index([experienceYearId])
  @@index([experienceMonthId])
  @@index([salaryBreakdownId])
  @@index([availabilityTypeId])
}

model Headline {
  id        String   @id @default(uuid())
  userId    String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // @Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ProfileSummary {
  id        String   @id @default(uuid())
  userId    String   @unique
  summary   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // @Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserSkill {
  id        String   @id @default(uuid())
  userId    String
  skillId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // @Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id])

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
}

model UserLanguage {
  id            String      @id @default(uuid())
  userId        String
  proficiencyId String
  languageId    String
  read          Boolean
  write         Boolean
  speak         Boolean
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  // @Relations
  proficiency   Proficiency @relation(fields: [proficiencyId], references: [id])
  language      Language    @relation(fields: [languageId], references: [id])
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, languageId])
  @@index([userId])
  @@index([languageId])
  @@index([proficiencyId])
}

model Education {
  id              String        @id @default(uuid())
  userId          String
  educationTypeId String
  university      String
  course          String
  specialization  String?
  startYear       String?
  endYear         String?
  gradeSystem     GradeSystem?
  marks           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  // @Relations
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  educationType   EducationType @relation(fields: [educationTypeId], references: [id])

  @@index([userId])
  @@index([educationTypeId])
}

model Experience {
  id                  String         @id @default(uuid())
  userId              String
  employmentTypeId    String
  isCurrentEmployment Boolean
  companyName         String
  jobTitle            String
  joiningDate         String
  workedTill          String?
  jobProfile          String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  // @Relations
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  employmentType      EmploymentType @relation(fields: [employmentTypeId], references: [id])

  @@index([userId])
  @@index([employmentTypeId])
}

model Project {
  id              String         @id @default(uuid())
  userId          String
  title           String
  client          String?
  status          ProjectStatus?
  startYear       Int?
  endYear         Int?
  details         String?
  location        String?
  site            String?
  type            String?
  teamSize        Int?
  role            String?
  roleDescription String?
  skillsUsed      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  // @Relations
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// end
