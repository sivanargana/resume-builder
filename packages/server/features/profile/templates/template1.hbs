<html>
  <head>
    <meta charset="UTF-8" />

    <style>
      :root {
        --font-size-base: 13px;
      }
      body {
        background-color: #eaf4ff;
        margin: 0px;
        font-family: sans-serif;
        font-size: var(--font-size-base);
        line-height: 1.5;
      }

      .sectionOne {
        display: flex;
        padding: 40px;
        background-color: white;
        gap: 40px;
      }
      .sectionOneLeft {
        flex: 1 1 0;
        display: flex;
        flex-direction: column;
        gap: 10px;
      }
      .sectionOneLeftShape {
        flex: 1 1 0;
        width: 50px;
        background-color: #5c7593;
        margin-top: -40px;
      }
      .sectionOneLeft h1 {
        margin: 0px;
        text-transform: uppercase;
        font-size: 30px;
      }
      .sectionOneLeft h1 span {
        color: #5c7593;
      }
      .sectionOneLeft h4 {
        margin: 0px;
        font-size: 16px;
      }
      .sectionOneRight {
        flex: none;
        display: flex;
        flex-direction: column;
        gap: 10px;
      }
      .sectionTwo {
        flex: 1 1 0;
        display: flex;
        padding: 40px;
        gap: 40px;
      }
      .sectionTwoSidebar {
        flex: none;
        width: 200px;
        display: flex;
        flex-direction: column;
        gap: 20px;
      }
      .sectionTwoContent {
        flex: 1 1 0;
        display: flex;
        flex-direction: column;
        gap: 20px;
      }
      .sectionTwoBox {
        background-color: #5c7593;
        color: white;
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 20px;
      }
      .sectionTwoBox ul,
      .sectionTwoBox ol {
        margin: 0px;
        padding-left: 20px;
      }

      .block {
        display: flex;
        flex-direction: column;
        gap: 10px;
      }
      .block h3 {
        margin: 0px;
        text-transform: uppercase;
      }

      .list {
        display: flex;
        flex-direction: column;
        gap: 10px;
      }

      .strong {
        font-weight: bold;
      }
      .muted {
        color: #5c7593;
      }
      .label {
        color: #5c7593;
        text-transform: uppercase;
        font-size: calc(var(--font-size-base) - 2px);
        font-weight: bold;
      }

      .labelValue {
        display: flex;
        flex-direction: column;
        gap: 0px;
      }
    </style>
  </head>

  <body class="page">

    <div class="sectionOne">
      <div class="sectionOneLeft">
        <div class="sectionOneLeftShape"></div>
        <h1>{{user.firstName}} <span>{{user.lastName}}</span></h1>
        <h4>{{headline.value}}</h4>
      </div>
      <div class="sectionOneRight">
        <div class="labelValue">
          <div class="label">Email</div>
          <div>{{user.email}}</div>
        </div>
        <div class="labelValue">
          <div class="label">Mobile</div>
          <div>{{user.mobile}}</div>
        </div>
        <div class="labelValue">
          <div class="label">Location</div>
          <div>{{basicDetails.location}}, {{basicDetails.country}}</div>
        </div>
        <div class="labelValue">
          <div class="label">Experience</div>
          <div>{{basicDetails.experienceYear.name}} - {{basicDetails.experienceMonth.name}}</div>
        </div>

      </div>
    </div>

    <div class="sectionTwo">
      <div class="sectionTwoSidebar">
        <div class="block">
          <h3>Profile Summary</h3>
          {{profileSummary.summary}}
        </div>

        <div class="sectionTwoBox">
          <div class="block">
            <h3>Skills</h3>
            <ul>
              {{#each userSkills}}
                <li>{{skill.name}}</li>
              {{/each}}
            </ul>
          </div>
          <div class="block">
            <h3>Languages</h3>
            <ul>
              {{#each userLanguages}}
                <li>{{language.name}}</li>
              {{/each}}
            </ul>
          </div>

        </div>

      </div>
      <div class="sectionTwoContent">

        <div class="block">
          <h3>Experience</h3>
          <div class="list">
            {{#each experiences}}
              <div>
                <div class="strong">{{jobTitle}}</div>
                <div>{{companyName}}</div>
                <div class="muted">{{joiningDate}} {{#if workedTill}} - {{workedTill}} {{/if}}</div>
                <div>{{jobProfile}}</div>
              </div>
            {{/each}}
          </div>
        </div>
        <div class="block">
          <h3>Education</h3>
          <div class="list">
            {{#each education}}
              <div>
                <div class="strong">{{course}}</div>
                <div>{{university}}</div>
                <div class="muted">{{startYear}} - {{endYear}}</div>
                <div>{{specialization}}</div>
              </div>
            {{/each}}
          </div>
        </div>
        <div class="block">
          <h3>Projects</h3>
          <div class="list">
            {{#each projects}}
              <div>
                <div class="strong">{{client}}</div>
                <div>{{role}}</div>
                <div class="muted">{{startYear}} - {{endYear}}</div>
                <div>{{details}}</div>
              </div>
            {{/each}}
          </div>
        </div>

      </div>
    </div>

  </body>
</html>